---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const timeline = (await getCollection('timeline')).sort((a, b) => a.data.order - b.data.order);
const featuredStory = (await getCollection('projects')).find((entry) => entry.id === 'multi-tenant-cloud-lifecycle' && entry.data.status === 'published');

const chapters = [
  { number: '01', label: 'Build', eyebrow: 'Systems in production', title: 'The work beneath the interface.', href: '#build', color: 'acid' },
  { number: '02', label: 'Journey', eyebrow: 'A life in motion', title: 'A path, still unfolding.', href: '#journey', color: 'blue' },
  { number: '03', label: 'Think', eyebrow: 'Open questions', title: 'Ideas under observation.', href: '#think', color: 'orange' },
  { number: '04', label: 'Life', eyebrow: 'Away from work', title: 'The things that make a life.', href: '#life', color: 'violet' },
];

const capabilities = ['Distributed systems', 'Cloud infrastructure', 'Python · C#', 'Azure · GCP', 'Kubernetes · Terraform', 'Reliability engineering'];
---

<BaseLayout>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="topbar">
    <a class="wordmark" href="#top" aria-label="Saw Luke Loo Wah, home"><span class="wordmark-mark">S<span>.</span></span><span class="wordmark-name">SAW LUKE LOO WAH</span></a>
    <nav aria-label="Main navigation">
      <a href="#build">Build</a><a href="#journey">Journey</a><a href="#think">Think</a><a href="#life">Life</a>
    </nav>
    <details class="mobile-menu">
      <summary aria-label="Section navigation"><span></span><span></span></summary>
      <div class="mobile-menu-panel" aria-label="Section navigation">
        <a href="#build">01 <span>Build</span><b>↗</b></a>
        <a href="#journey">02 <span>Journey</span><b>↗</b></a>
        <a href="#think">03 <span>Think</span><b>↗</b></a>
        <a href="#life">04 <span>Life</span><b>↗</b></a>
      </div>
    </details>
  </header>

  <main id="main">
    <section class="hero page-shell" id="top" aria-labelledby="hero-title">
      <div class="hero-topline mono"><span>PERSONAL SYSTEMS ARCHIVE</span><span>EST. IN PROGRESS&nbsp; <i class="status-dot"></i></span></div>
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-line"></span> A living record by Saw Luke Loo (Luke) Wah</p>
        <h1 id="hero-title">I build systems.<br /><span>I also happen to be one.</span></h1>
        <div class="hero-bottom">
          <p class="hero-intro">An engineer, a set of moving parts, and the stories connecting them. This is a closer look at the work—and the person behind it.</p>
          <a class="enter-link" href="#build"><span class="enter-icon" aria-hidden="true">↓</span><span>ENTER THE ARCHIVE</span><span class="enter-index">[ 01 — 04 ]</span></a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div>
        <div class="orbit-core"><span>LUKE<br />WAH</span><i></i></div>
        <span class="orbit-label label-a">CURIOSITY <b>↗</b></span><span class="orbit-label label-b">SYSTEMS <b>↗</b></span><span class="orbit-label label-c">PEOPLE <b>↗</b></span>
        <span class="coordinate coord-a">YANGON / MYANMAR<br />2019</span><span class="coordinate coord-b">GAINESVILLE / FL<br />2017—2021</span>
      </div>
      <div class="hero-index mono"><span>001</span><span class="index-line"></span><span>AN INTRODUCTION</span></div>
    </section>

    <section class="signal-strip" aria-label="Professional snapshot">
      <div class="signal-inner page-shell">
        <div class="signal-heading mono"><span class="status-dot"></span> FIELD NOTES <span class="signal-slash">/</span> CURRENT SIGNAL</div>
        <div class="signal-item"><strong>Senior Software Engineer</strong><span>Citrix · since 2021</span></div>
        <div class="signal-item"><strong>Tens of thousands</strong><span>of tenants supported</span></div>
        <div class="signal-item"><strong>Multi-cloud</strong><span>Azure · GCP · platform</span></div>
        <div class="signal-aside mono">STATUS: IN MOTION</div>
      </div>
    </section>

    <section class="chapter-section page-shell" id="chapters" aria-labelledby="chapters-heading">
      <div class="section-heading">
        <div><p class="eyebrow"><span class="eyebrow-line"></span> THE ARCHIVE</p><h2 id="chapters-heading">Four ways in.<br /><span>One person throughout.</span></h2></div>
        <p class="section-aside">Not a list of credentials. A collection of contexts: what I make, where I came from, what I’m considering, and what exists beyond the work.</p>
      </div>
      <div class="chapter-grid">
        {chapters.map((chapter) => (
          <a class={`chapter-card ${chapter.color}`} href={chapter.href}>
            <div class="card-meta mono"><span>{chapter.number} / 04</span><span class="card-symbol" aria-hidden="true">↗</span></div>
            <p class="card-eyebrow">{chapter.eyebrow}</p>
            <h3>{chapter.label}</h3>
            <p class="card-title">{chapter.title}</p>
            <span class="card-bottom mono">OPEN CHAPTER <span>↗</span></span>
          </a>
        ))}
      </div>
    </section>

    <section class="build-section page-shell" id="build" aria-labelledby="build-title">
      <div class="build-top">
        <div><p class="eyebrow"><span class="eyebrow-line"></span> 01 / BUILD</p><h2 id="build-title">Make complexity<br />feel <em>understandable.</em></h2></div>
        <p class="build-lede">I work on the infrastructure people rarely see and depend on every day: provisioning, control planes, and the systems that make change safe at scale.</p>
      </div>
      <div class="architecture" role="img" aria-label="Conceptual flow: customer environments connect through a control plane to resilient cloud infrastructure">
        <div class="arch-label mono">A SIMPLIFIED VIEW / THE WORK IN BETWEEN</div>
        <div class="arch-flow">
          <div class="arch-node"><span class="node-icon people-icon">◎</span><strong>Customer<br />environments</strong><small>many tenants · many needs</small></div>
          <span class="connector"><i></i><b>PROVISION</b><i></i></span>
          <div class="arch-node central"><span class="node-icon">⌘</span><strong>Control plane</strong><small>orchestrate · observe · recover</small></div>
          <span class="connector"><i></i><b>OPERATE</b><i></i></span>
          <div class="arch-node"><span class="node-icon cloud-icon">⌁</span><strong>Cloud<br />infrastructure</strong><small>regions · services · capacity</small></div>
        </div>
        <div class="arch-foot mono"><span><i class="legend-dot"></i> SYSTEM BOUNDARY</span><span>AVAILABILITY / SECURITY / COST</span><span>NOT TO SCALE</span></div>
      </div>
      <div class="capability-row">
        <div class="capability-title mono">WORKING TOOLKIT <span>↘</span></div>
        <div class="capability-tags">{capabilities.map((item) => <span>{item}</span>)}</div>
      </div>
      {featuredStory && <article class="build-story" aria-labelledby="story-title">
        <div class="story-kicker mono"><span>FIELD STORY / 01</span><span>{featuredStory.data.period}</span></div>
        <h3 id="story-title">{featuredStory.data.title}</h3>
        <p class="story-summary">{featuredStory.data.summary}</p>
        <div class="story-grid">
          <div><span class="story-label mono">THE CHALLENGE</span><p>{featuredStory.data.story.problem}</p></div>
          <div><span class="story-label mono">THE CONSTRAINTS</span><p>{featuredStory.data.story.constraints}</p></div>
          <div><span class="story-label mono">THE SYSTEM</span><p>{featuredStory.data.story.architecture}</p></div>
          <div><span class="story-label mono">THE WORK</span><p>{featuredStory.data.story.whatIBuilt}</p></div>
          <div><span class="story-label mono">WHAT THE WORK REVEALED</span><p>{featuredStory.data.story.decisions}</p></div>
          <div><span class="story-label mono">THE IMPACT</span><p>{featuredStory.data.story.impact}</p></div>
        </div>
      </article>}
    </section>

    <section class="journey-section page-shell" id="journey" aria-labelledby="journey-title">
      <div class="journey-intro"><p class="eyebrow"><span class="eyebrow-line"></span> 02 / JOURNEY</p><h2 id="journey-title">A few coordinates.<br /><span>No straight lines.</span></h2><p>Place is part of the system, too. A brief map of the chapters I can name so far.</p><a class="text-link" href="#timeline">Follow the timeline <span>↗</span></a></div>
      <div class="timeline" id="timeline">
        {timeline.map((entry, index) => (
          <details class="timeline-item">
            <summary class="timeline-summary">
              <span class="timeline-year">{entry.data.period}</span>
              <span class:list={['timeline-dot', { active: index === timeline.length - 1 }]}></span>
              <span class="timeline-copy"><strong>{entry.data.title}</strong><span>{entry.data.summary}</span></span>
              <span class="timeline-tag">{entry.data.tag}</span>
              <span class="timeline-toggle" aria-hidden="true">+</span>
            </summary>
            {entry.data.detail && <p class="timeline-details">{entry.data.detail}</p>}
          </details>
        ))}
      </div>
    </section>

    <section class="thoughts-section page-shell" id="think" aria-labelledby="think-title">
      <div class="thought-head"><div><p class="eyebrow"><span class="eyebrow-line"></span> 03 / THINK</p><h2 id="think-title">Questions I’m<br /><span>keeping open.</span></h2></div><span class="thought-count mono">FIELD NOTES / 000</span></div>
      <div class="thought-bottom"><p>AI agents raise a practical question: how do we use their speed without settling for AI slop? I’m interested in keeping the work grounded in sound engineering, thoughtful system design, and architecture that holds up beyond the first draft.</p><p class="future-note mono"><span>FIELD NOTES</span> AWAITING FIRST ENTRY</p></div>
    </section>

    <section class="life-section page-shell" id="life" aria-labelledby="life-title">
      <div class="life-card"><div class="life-text"><p class="eyebrow"><span class="eyebrow-line"></span> 04 / LIFE</p><h2 id="life-title">Good food,<br />good company,<br /><em>questionable golf.</em></h2><p>I love cooking dishes from cuisines around the world—and I’m a very enthusiastic eater, too. Give me a new town to wander, a cozy café, video games, or a good manga. Best of all: time with family and friends. I golf occasionally; my swing is still a work in progress, and the ball has yet to offer useful feedback.</p><p class="future-note mono"><span>LIFE LATELY</span> MORE STORIES TO COME</p></div><div class="life-art" aria-hidden="true"><div class="sun"></div><div class="horizon horizon-back"></div><div class="horizon horizon-front"></div><span class="art-caption mono">TAKE THE SCENIC ROUTE</span><span class="art-coordinate mono">COFFEE FIRST<br />THEN EVERYWHERE</span></div></div>
    </section>

    <section class="closing page-shell"><span class="closing-mark">S<span>.</span></span><p>Still becoming.<br /><em>Still building.</em></p><a href="#top" class="back-top mono">BACK TO TOP ↑</a></section>
  </main>

  <footer class="footer page-shell"><span>© {new Date().getFullYear()} SAW LUKE LOO WAH</span><span>BUILT WITH INTENTION <i class="status-dot"></i></span><a href="https://linkedin.com/in/swah0/" target="_blank" rel="noreferrer">LINKEDIN ↗</a></footer>
</BaseLayout>

<script>
  const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.open = false;
    });
  });
</script>

<style>
  .page-shell { width: min(var(--page-width), calc(100% - 112px)); margin-inline: auto; }
  .mono, .eyebrow, .wordmark-name { font-family: var(--mono); letter-spacing: .08em; }
  .mono { font-size: 10px; }
  .skip-link { position: absolute; top: -60px; left: 20px; z-index: 10; padding: 10px 14px; background: var(--acid); color: var(--bg); }
  .skip-link:focus { top: 12px; }
  .topbar { height: 74px; padding: 0 max(56px, calc((100vw - var(--page-width))/2)); border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 5; background: rgba(16,17,15,.88); backdrop-filter: blur(16px); }
  .wordmark { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .wordmark-mark { font: 700 27px/1 var(--serif); letter-spacing: -.1em; }.wordmark-mark span,.closing-mark span { color: var(--acid); }
  .wordmark-name { font-size: 9px; color: var(--muted); }
  .topbar nav { display: flex; gap: clamp(22px, 3vw, 44px); }.topbar nav a { text-decoration: none; font-size: 12px; color: var(--muted); transition: color .2s; }.topbar nav a:hover { color: var(--text); }
  .mobile-menu { display: none; }
  .status-dot { display: inline-block; width: 6px; height: 6px; flex: 0 0 auto; border-radius: 50%; background: var(--acid); box-shadow: 0 0 12px rgba(214,239,119,.42); }
  .hero { min-height: 650px; position: relative; display: flex; flex-direction: column; justify-content: space-between; padding-top: 28px; padding-bottom: 26px; overflow: hidden; }
  .hero-topline { display: flex; justify-content: space-between; color: var(--quiet); font-size: 9px; }.hero-topline .status-dot { margin-left: 5px; vertical-align: 1px; }
  .hero-copy { position: relative; z-index: 1; padding: 76px 0 52px; }
  .eyebrow { display: flex; align-items: center; gap: 11px; margin: 0; color: var(--muted); font-size: 9px; text-transform: uppercase; }.eyebrow-line { width: 22px; height: 1px; background: var(--acid); }
  h1,h2,h3,p { margin-top: 0; }.hero h1 { max-width: 900px; margin: 24px 0 33px; font: 500 clamp(52px, 6.9vw, 94px)/.99 var(--serif); letter-spacing: -.075em; }.hero h1 span { color: var(--muted); }
  .hero-bottom { display: flex; align-items: end; justify-content: space-between; gap: 32px; max-width: 790px; }.hero-intro { max-width: 350px; margin: 0; color: var(--muted); font-size: 14px; line-height: 1.75; }
  .enter-link { display: flex; align-items: center; gap: 13px; padding-bottom: 5px; color: var(--text); text-decoration: none; font: 10px var(--mono); letter-spacing: .06em; }.enter-icon { width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid var(--line-strong); border-radius: 50%; color: var(--acid); font-size: 17px; transition: background .2s, transform .2s; }.enter-link:hover .enter-icon { background: var(--acid-dim); transform: translateY(3px); }.enter-index { color: var(--quiet); font-size: 8px; margin-left: 6px; }
  .hero-visual { position: absolute; right: 4%; top: 140px; width: 390px; height: 390px; opacity: .73; }.orbit { position: absolute; border: 1px solid var(--line); border-radius: 50%; inset: 0; }.orbit-one { transform: scale(.98) rotate(-16deg); border-color: rgba(214,239,119,.22); }.orbit-two { inset: 34px; transform: rotate(36deg) scaleX(.73); border-color: var(--line-strong); }.orbit-three { inset: 62px; transform: rotate(-32deg) scaleY(.82); border-style: dashed; }.orbit-core { position: absolute; inset: 135px; display: grid; place-items: center; text-align: center; border-radius: 50%; border: 1px solid rgba(214,239,119,.4); background: radial-gradient(circle, rgba(214,239,119,.1), transparent 70%); font: 10px/1.4 var(--mono); letter-spacing: .16em; color: var(--acid); }.orbit-core i { position: absolute; width: 7px; height: 7px; right: -3px; top: 18px; border-radius: 50%; background: var(--acid); box-shadow: 0 0 16px var(--acid); }
  .orbit-label { position: absolute; font: 8px var(--mono); color: var(--muted); letter-spacing: .08em; }.orbit-label b { color: var(--acid); margin-left: 5px; font-weight: 400; }.label-a { top: 30px; left: 195px; }.label-b { right: -2px; top: 192px; }.label-c { left: 24px; bottom: 49px; }.coordinate { position: absolute; font: 8px/1.6 var(--mono); color: var(--quiet); }.coord-a { top: 123px; left: -3px; }.coord-b { right: 23px; bottom: 74px; }
  .hero-index { display: flex; align-items: center; gap: 12px; color: var(--quiet); font-size: 9px; }.index-line { height: 1px; width: 66px; background: var(--line-strong); }
  .signal-strip { border-block: 1px solid var(--line); background: #141512; }.signal-inner { min-height: 94px; display: grid; grid-template-columns: 1.5fr 1.4fr .9fr 1.1fr auto; align-items: center; gap: 25px; }.signal-heading,.signal-aside { color: var(--quiet); font: 8px var(--mono); letter-spacing: .06em; }.signal-heading .status-dot { margin-right: 8px; }.signal-slash { color: var(--acid); margin: 0 4px; }.signal-item { display: flex; flex-direction: column; gap: 2px; border-left: 1px solid var(--line); padding-left: 20px; }.signal-item strong { font-size: 12px; font-weight: 500; }.signal-item span { color: var(--quiet); font-size: 10px; }.signal-aside { text-align: right; }
  .chapter-section { padding-top: 144px; padding-bottom: 140px; }.section-heading { display: flex; justify-content: space-between; align-items: end; margin-bottom: 53px; }.section-heading h2,.journey-intro h2,.thought-head h2 { margin: 22px 0 0; font: 500 clamp(40px,5.1vw,64px)/1.07 var(--serif); letter-spacing: -.06em; }.section-heading h2 span,.journey-intro h2 span,.thought-head h2 span { color: var(--muted); }.section-aside { max-width: 300px; margin: 0 0 5px; color: var(--muted); font-size: 12px; line-height: 1.75; }
  .chapter-grid { display: grid; grid-template-columns: repeat(4,1fr); border: 1px solid var(--line); }.chapter-card { min-height: 316px; position: relative; padding: 21px 22px 19px; text-decoration: none; background: rgba(255,255,255,.012); transition: background .25s, transform .25s; }.chapter-card + .chapter-card { border-left: 1px solid var(--line); }.chapter-card:hover { z-index: 1; background: var(--surface-raised); transform: translateY(-4px); }.card-meta { display: flex; justify-content: space-between; color: var(--quiet); font-size: 9px; }.card-symbol { color: var(--chapter); font-size: 16px; }.card-eyebrow { margin: 38px 0 3px; color: var(--chapter); font: 8px var(--mono); text-transform: uppercase; letter-spacing: .08em; }.chapter-card h3 { margin: 0; font: 500 25px var(--serif); letter-spacing: -.04em; }.card-title { max-width: 190px; margin: 13px 0 0; font-size: 12px; line-height: 1.45; }.card-bottom { position: absolute; left: 22px; right: 22px; bottom: 19px; display: flex; justify-content: space-between; color: var(--quiet); font-size: 8px; }.card-bottom span { color: var(--chapter); font-size: 14px; }.acid { --chapter: var(--acid); }.blue { --chapter: #88b4d7; }.orange { --chapter: var(--orange); }.violet { --chapter: #b8a3d6; }
  .build-section { padding: 10px 0 145px; }.build-top { display: flex; justify-content: space-between; align-items: end; margin-bottom: 49px; }.build-top h2,.life-text h2 { margin: 19px 0 0; font: 500 clamp(40px,5.2vw,66px)/1.05 var(--serif); letter-spacing: -.065em; }.build-top h2 em,.life-text h2 em,.closing em { color: var(--acid); font-style: normal; }.build-lede { max-width: 370px; margin: 0 0 5px; color: var(--muted); font-size: 13px; line-height: 1.8; }
  .architecture { border: 1px solid var(--line); padding: 19px 22px 15px; background: linear-gradient(130deg, rgba(214,239,119,.025), transparent 55%); }.arch-label,.arch-foot { color: var(--quiet); font: 8px var(--mono); letter-spacing: .06em; }.arch-flow { min-height: 220px; display: grid; grid-template-columns: 1fr .72fr 1.12fr .72fr 1fr; align-items: center; gap: 12px; padding: 24px 5%; }.arch-node { min-height: 112px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; border: 1px solid var(--line-strong); background: rgba(255,255,255,.018); position: relative; }.arch-node.central { min-height: 143px; border-color: rgba(214,239,119,.45); background: radial-gradient(ellipse at 50% 0%, rgba(214,239,119,.08), transparent 80%); }.node-icon { color: var(--acid); font: 26px var(--mono); margin-bottom: 8px; }.people-icon { color: #88b4d7; }.cloud-icon { color: var(--orange); }.arch-node strong { font-size: 11px; font-weight: 500; line-height: 1.35; }.arch-node small { margin-top: 5px; color: var(--quiet); font: 8px var(--mono); }.connector { display: flex; align-items: center; gap: 5px; color: var(--quiet); font: 7px var(--mono); }.connector i { height: 1px; flex: 1; background: linear-gradient(90deg, transparent, var(--line-strong)); }.connector i:last-child { background: linear-gradient(90deg,var(--line-strong),transparent); }.connector b { color: var(--muted); font-weight: 400; }.arch-foot { display: flex; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 13px; font-size: 7px; }.legend-dot { display: inline-block; vertical-align: 1px; width: 6px; height: 6px; border: 1px solid var(--acid); margin-right: 5px; }
  .capability-row { display: grid; grid-template-columns: 180px 1fr; gap: 22px; align-items: start; padding: 27px 0 22px; border-bottom: 1px solid var(--line); }.capability-title { padding-top: 7px; color: var(--quiet); font-size: 8px; }.capability-title span { color: var(--acid); margin-left: 7px; }.capability-tags { display: flex; flex-wrap: wrap; gap: 8px; }.capability-tags span { padding: 7px 10px; border: 1px solid var(--line); color: var(--muted); font-size: 10px; }.text-link { display: inline-flex; align-items: center; gap: 15px; margin-top: 24px; text-decoration: none; font-size: 11px; border-bottom: 1px solid var(--line-strong); padding-bottom: 7px; }.text-link span { color: var(--acid); font-size: 14px; transition: transform .2s; }.text-link:hover span { transform: translate(2px,-2px); }
  .future-note { display: flex; align-items: center; gap: 11px; margin: 24px 0 0; color: var(--quiet); font: 8px var(--mono); letter-spacing: .06em; }.future-note span { color: var(--acid); }
  .thought-bottom .future-note { max-width: none; margin: 0; }
  .life-text > .future-note { margin-top: 22px; font: 8px var(--mono); }
  .journey-section { padding: 95px 0 147px; display: grid; grid-template-columns: .85fr 1.15fr; gap: 12%; border-top: 1px solid var(--line); }.journey-intro > p:not(.eyebrow) { max-width: 270px; margin: 21px 0 0; color: var(--muted); font-size: 12px; line-height: 1.75; }.journey-intro .text-link { margin-top: 25px; }.timeline { padding-top: 9px; }.timeline-item { min-height: 110px; display: grid; grid-template-columns: 66px 14px 1fr auto; gap: 12px; align-items: start; position: relative; }.timeline-item:not(:last-child)::after { content: ''; position: absolute; left: 83px; top: 19px; bottom: -1px; width: 1px; background: var(--line-strong); }.timeline-year { color: var(--quiet); font: 9px var(--mono); padding-top: 3px; }.timeline-dot { z-index: 1; width: 7px; height: 7px; margin-top: 4px; border: 1px solid var(--acid); border-radius: 50%; background: var(--bg); }.timeline-dot.active { background: var(--acid); box-shadow: 0 0 12px rgba(214,239,119,.4); }.timeline-item h3 { margin: -4px 0 4px; font: 500 15px var(--serif); }.timeline-item p { margin: 0; color: var(--muted); font-size: 11px; }.timeline-tag { color: var(--quiet); font: 7px var(--mono); letter-spacing: .05em; padding-top: 3px; }
  .timeline-summary { grid-column: 1 / -1; min-height: 110px; display: grid; grid-template-columns: 66px 14px minmax(0, 1fr) auto 12px; gap: 12px; align-items: start; list-style: none; cursor: pointer; }
  .timeline-summary::-webkit-details-marker { display: none; }
  .timeline-summary:focus-visible { outline: 2px solid var(--acid); outline-offset: 4px; }
  .timeline-copy { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .timeline-copy strong { margin-top: -4px; font: 500 15px var(--serif); transition: color .2s; }
  .timeline-copy > span { color: var(--muted); font-size: 11px; }
