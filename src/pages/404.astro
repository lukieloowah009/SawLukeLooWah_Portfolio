---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — The Systems Behind Me" description="This path does not exist in Luke Wah's portfolio archive.">
  <main class="not-found">
    <a class="wordmark" href={`${import.meta.env.BASE_URL}/`} aria-label="Return to The Systems Behind Me home">
      <span class="wordmark-mark">S<span>.</span></span>
      <span class="wordmark-name">SAW LUKE LOO WAH</span>
    </a>
    <div class="not-found-copy">
      <p class="eyebrow"><span class="eyebrow-line"></span> ARCHIVE / 404</p>
      <h1>This path<br /><span>doesn’t resolve.</span></h1>
      <p>The page may have moved, or this chapter hasn’t been written yet.</p>
      <a class="return-link" href={`${import.meta.env.BASE_URL}/`}>Return to the archive <span aria-hidden="true">↗</span></a>
    </div>
    <div class="not-found-foot mono"><span>STATUS / UNRESOLVED ROUTE</span><span>TRY / HOME</span></div>
  </main>
</BaseLayout>

<style>
  .not-found { min-height: 100svh; width: min(1550px, calc(100% - 140px)); margin-inline: auto; padding: 37.5px 0 30px; display: flex; flex-direction: column; justify-content: space-between; }
  .wordmark { display: flex; align-items: center; gap: 15px; width: fit-content; text-decoration: none; }
  .wordmark-mark { font: 700 33.75px/1 Georgia, serif; letter-spacing: -.1em; }
  .wordmark-mark span { color: var(--acid); }
  .wordmark-name,.mono { color: var(--quiet); font: 11.25px var(--mono); letter-spacing: .08em; }
  .not-found-copy { padding: 125px 0 168.75px; }
  .eyebrow { display: flex; align-items: center; gap: 13.75px; color: var(--muted); font: 11.25px var(--mono); letter-spacing: .08em; }
  .eyebrow-line { width: 27.5px; height: 1.25px; background: var(--acid); }
  h1 { margin: 28.75px 0 22.5px; font: 500 clamp(60px, 8vw, 125px)/1 var(--serif); letter-spacing: -.07em; }
  h1 span { color: var(--muted); }
  .not-found-copy > p:not(.eyebrow) { max-width: 475px; color: var(--muted); font-size: 16.25px; line-height: 1.8; }
  .return-link { display: inline-flex; gap: 17.5px; align-items: center; margin-top: 15px; border-bottom: 1.25px solid var(--line-strong); padding: 0 0 8.75px; color: var(--text); font-size: 15px; text-decoration: none; }
  .return-link span { color: var(--acid); font-size: 20px; }
  .not-found-foot { display: flex; justify-content: space-between; border-top: 1.25px solid var(--line); padding-top: 17.5px; }
  @media (max-width: 875px) { .not-found { width: calc(100% - 50px); padding-top: 27.5px; }.not-found-copy { padding: 100px 0 137.5px; }h1 { font-size: clamp(57.5px, 12vw, 90px); }.not-found-foot,.wordmark-name { font-size: 10px; } }
</style>
