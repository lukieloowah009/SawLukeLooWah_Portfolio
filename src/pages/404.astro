---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — The Systems Behind Me" description="This path does not exist in Luke Wah's portfolio archive.">
  <main class="not-found">
    <a class="wordmark" href="/" aria-label="Return to The Systems Behind Me home">
      <span class="wordmark-mark">S<span>.</span></span>
      <span class="wordmark-name">SAW LUKE LOO WAH</span>
    </a>
    <div class="not-found-copy">
      <p class="eyebrow"><span class="eyebrow-line"></span> ARCHIVE / 404</p>
      <h1>This path<br /><span>doesn’t resolve.</span></h1>
      <p>The page may have moved, or this chapter hasn’t been written yet.</p>
      <a class="return-link" href="/">Return to the archive <span aria-hidden="true">↗</span></a>
    </div>
    <div class="not-found-foot mono"><span>STATUS / UNRESOLVED ROUTE</span><span>TRY / HOME</span></div>
  </main>
</BaseLayout>

<style>
  .not-found { min-height: 100svh; width: min(1240px, calc(100% - 112px)); margin-inline: auto; padding: 30px 0 24px; display: flex; flex-direction: column; justify-content: space-between; }
  .wordmark { display: flex; align-items: center; gap: 12px; width: fit-content; text-decoration: none; }
  .wordmark-mark { font: 700 27px/1 Georgia, serif; letter-spacing: -.1em; }
  .wordmark-mark span { color: var(--acid); }
  .wordmark-name,.mono { color: var(--quiet); font: 9px var(--mono); letter-spacing: .08em; }
  .not-found-copy { padding: 100px 0 135px; }
  .eyebrow { display: flex; align-items: center; gap: 11px; color: var(--muted); font: 9px var(--mono); letter-spacing: .08em; }
  .eyebrow-line { width: 22px; height: 1px; background: var(--acid); }
  h1 { margin: 23px 0 18px; font: 500 clamp(48px, 8vw, 100px)/1 var(--serif); letter-spacing: -.07em; }
  h1 span { color: var(--muted); }
  .not-found-copy > p:not(.eyebrow) { max-width: 380px; color: var(--muted); font-size: 13px; line-height: 1.8; }
  .return-link { display: inline-flex; gap: 14px; align-items: center; margin-top: 12px; border-bottom: 1px solid var(--line-strong); padding: 0 0 7px; color: var(--text); font-size: 12px; text-decoration: none; }
  .return-link span { color: var(--acid); font-size: 16px; }
  .not-found-foot { display: flex; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 14px; }
  @media (max-width: 700px) { .not-found { width: calc(100% - 40px); padding-top: 22px; }.not-found-copy { padding: 80px 0 110px; }h1 { font-size: clamp(46px, 12vw, 72px); }.not-found-foot,.wordmark-name { font-size: 8px; } }
</style>
